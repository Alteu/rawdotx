{% doc %}
  Product JSON-LD for search engines and AI shopping assistants: brand, price in the store currency,
  availability, images and the return policy (all sales final). Used on the homepage for every
  showcase product and on product pages.

  @param {product} product - The Shopify product
  @param {string} [name] - Display name (defaults to the product title)
  @param {string} [description] - Fallback description when the product has none
  @param {string} [image_files] - Theme image files, separated by commas, listed before the product's own
{% enddoc %}
{%- liquid
  assign display_name = name | default: product.title
  assign variant = product.selected_or_first_available_variant
  assign product_url = request.origin | append: product.url
  # Put a space before every tag and line break first, so paragraphs don't run together.
  assign text = product.description | newline_to_br | replace: '<', ' <' | strip_html | strip_newlines
  assign text = text | split: ' ' | join: ' ' | strip | truncate: 600
  if text == blank
    assign text = description
  endif
  if variant.available
    assign availability = 'https://schema.org/InStock'
  else
    assign availability = 'https://schema.org/OutOfStock'
  endif
  assign asset_files = ''
  if image_files != blank
    assign asset_files = image_files | split: ','
  endif
  assign image_list = ''
  for file in asset_files
    assign image_url = file | strip | asset_url
    assign image_list = image_list | append: 'https:' | append: image_url | append: '~~'
  endfor
  assign product_images = product.media | where: 'media_type', 'image'
  for media in product_images limit: 6
    assign image_url = media | image_url: width: 1600
    assign image_list = image_list | append: 'https:' | append: image_url | append: '~~'
  endfor
  assign image_urls = image_list | split: '~~'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ product_url | append: '#product' | json }},
    "name": {{ display_name | prepend: 'rawdot ' | json }},
    "description": {{ text | json }},
    "url": {{ product_url | json }},
    {%- if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
    {%- if variant.barcode != blank %}"gtin": {{ variant.barcode | json }},{% endif %}
    "category": {{ product.type | default: 'Mouse skates' | json }},
    "brand": { "@type": "Brand", "name": "rawdot" },
    "image": {{ image_urls | json }},
    "offers": {
      "@type": "Offer",
      "url": {{ product_url | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": {{ availability | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "seller": { "@id": {{ request.origin | append: '/#organization' | json }} },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "MX",
        "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
      }
    }
  }
</script>
