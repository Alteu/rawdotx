{% doc %}
  Dark title band for Shopify policy pages (terms, privacy, refunds, shipping): the policy's name and
  links to the other policies. Shopify renders the policy text itself below it.
{% enddoc %}
{%- liquid
  assign current_handle = request.path | split: '/' | last
  assign current_title = page_title
  for policy in shop.policies
    assign policy_handle = policy.url | split: '/' | last
    if policy_handle == current_handle
      assign current_title = policy.title
    endif
  endfor
-%}
<section class="policy-hero scheme-dark">
  <div class="policy-hero__inner page-width">
    <p class="section-label">rawdot / {{ 'footer.legal' | t }}</p>
    <p class="policy-hero__title" aria-hidden="true">{{ current_title | escape }}</p>
    <nav class="policy-tabs" aria-label="{{ 'footer.legal' | t }}">
      <ul role="list">
        {%- for policy in shop.policies -%}
          {%- assign policy_handle = policy.url | split: '/' | last -%}
          <li>
            <a
              href="{{ policy.url }}"
              {% if policy_handle == current_handle %}
                aria-current="page"
              {% endif %}
            >
              {{- policy.title | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</section>
