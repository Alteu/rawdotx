{% doc %}
  Exposes theme settings as CSS custom properties. `.scheme-dark` switches an area to the dark palette.
{% enddoc %}
{%- liquid
  assign body_font = settings.type_body_font
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_semibold = body_font | font_modify: 'weight', '600'
-%}
{% style %}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_medium | font_face: font_display: 'swap' }}
  {{ body_font_semibold | font_face: font_display: 'swap' }}

  :root {
    --color-background: {{ settings.color_background }};
    --color-foreground: {{ settings.color_foreground }};
    --color-surface: {{ settings.color_surface }};
    --color-muted: {{ settings.color_muted }};
    --color-border: {{ settings.color_border }};
    --color-dot: {{ settings.color_border }};
    --color-on-foreground: {{ settings.color_background }};
    --page-width: 96rem;
    --page-margin: clamp(1rem, 3.5vw, 2.5rem);
    --header-height: 3.75rem;
    --radius: 0.5rem;
    --font-body: {{ body_font.family }}, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
    --font-mono: ui-monospace, 'SF Mono', 'Cascadia Mono', 'Roboto Mono', Menlo, Consolas, monospace;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scheme-dark {
    --color-background: {{ settings.color_dark_background }};
    --color-foreground: {{ settings.color_dark_foreground }};
    --color-surface: {{ settings.color_dark_surface }};
    --color-muted: {{ settings.color_dark_muted }};
    --color-border: {{ settings.color_dark_border }};
    --color-dot: {{ settings.color_dark_border }};
    --color-on-foreground: {{ settings.color_dark_background }};
    color-scheme: dark;
  }
{% endstyle %}
