{% doc %}
  Exposes theme settings as CSS custom properties.
{% enddoc %}
{% style %}
  :root {
    --color-background: {{ settings.color_background }};
    --color-foreground: {{ settings.color_foreground }};
    --color-surface: {{ settings.color_surface }};
    --color-muted: {{ settings.color_muted }};
    --color-border: {{ settings.color_border }};
    --page-width: 90rem;
    --page-margin: clamp(1rem, 4vw, 2.5rem);
    --header-height: 3.75rem;
    --radius: 0.375rem;
    --font-body: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
  }
{% endstyle %}
