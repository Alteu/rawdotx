{% doc %}
  "About us" side sheet, opened from the header (right side). Holds the rawdot origin story.
{% enddoc %}
<dialog class="details-dialog about-dialog" id="AboutDialog" aria-labelledby="AboutDialogTitle">
  <div class="details-dialog__header">
    <p class="details-dialog__title">{{ 'about.label' | t }}</p>
    <form method="dialog">
      <button type="submit" class="button button--icon">
        {% render 'icon', name: 'close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
    </form>
  </div>
  <div class="details-dialog__body about">
    {% render 'logo-mark', class: 'about__mark' %}
    <h2 class="about__heading" id="AboutDialogTitle">{{ 'about.heading' | t }}</h2>
    <blockquote class="about__quote">
      <p>{{ 'about.quote' | t }}</p>
    </blockquote>
    <p>{{ 'about.description' | t }}</p>
    <ul class="about__principles" role="list">
      {%- for i in (1..4) -%}
        {%- liquid
          assign title_key = 'about.principle_' | append: i | append: '_title'
          assign text_key = 'about.principle_' | append: i | append: '_description'
        -%}
        <li>
          <h3>{{ title_key | t }}</h3>
          <p>{{ text_key | t }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</dialog>
