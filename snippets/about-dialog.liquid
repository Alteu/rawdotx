{% doc %}
  "About us" side sheet, opened from the header (right side): how RAWDOT started, as a short timeline.
{% enddoc %}
<dialog class="details-dialog about-dialog" id="AboutDialog" aria-labelledby="AboutDialogTitle">
  <div class="about-dialog__hero scheme-dark">
    <form method="dialog" class="about-dialog__close">
      <button type="submit" class="button button--icon">
        {% render 'icon', name: 'close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
    </form>
    {% render 'logo-mark', class: 'about-dialog__mark' %}
    <div>
      <p class="section-label">{{ 'about.label' | t }}</p>
      <h2 class="about-dialog__title" id="AboutDialogTitle">{{ 'about.heading' | t }}</h2>
    </div>
  </div>

  <div class="about-dialog__body">
    <p class="about-dialog__lead">{{ 'about.lead' | t }}</p>

    <p class="section-label">{{ 'about.story_label' | t }}</p>
    <ol class="about-timeline" role="list">
      {%- for i in (1..4) -%}
        {%- liquid
          assign title_key = 'about.step_' | append: i | append: '_title'
          assign text_key = 'about.step_' | append: i | append: '_text'
        -%}
        <li class="about-timeline__step">
          <h3>{{ title_key | t }}</h3>
          <p>{{ text_key | t }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</dialog>
