{% doc %}
  "About us" view, opened from the header: how RAWDOT started. Full screen, split into a black brand
  panel (real wordmark, lead) and the story as a four-step timeline. Stacks on small screens.
{% enddoc %}
<dialog class="about-dialog" id="AboutDialog" aria-labelledby="AboutDialogTitle">
  <form method="dialog" class="about-dialog__close">
    <button type="submit" class="button button--icon">
      {% render 'icon', name: 'close' %}
      <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
    </button>
  </form>

  <div class="about-dialog__brand scheme-dark">
    <p class="section-label">{{ 'about.label' | t }}</p>
    <h2 class="about-dialog__title" id="AboutDialogTitle">
      <img
        src="{{ 'rawdot-wordmark-inverted.png' | asset_url }}"
        alt="{{ 'about.heading' | t | escape }}"
        width="362"
        height="260"
      >
    </h2>
    <p class="about-dialog__lead">{{ 'about.lead' | t }}</p>
  </div>

  <div class="about-dialog__story">
    <p class="section-label">{{ 'about.story_label' | t }}</p>
    <ol class="about-timeline" role="list">
      {%- for i in (1..4) -%}
        {%- liquid
          assign title_key = 'about.step_' | append: i | append: '_title'
          assign text_key = 'about.step_' | append: i | append: '_text'
        -%}
        <li class="about-timeline__step">
          <span class="about-timeline__number" aria-hidden="true">0{{ i }}</span>
          <h3>{{ title_key | t }}</h3>
          <p>{{ text_key | t }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</dialog>
