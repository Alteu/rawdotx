{% doc %}
  Renders the document title, description, canonical URL, favicons, social sharing tags and structured data.
  The homepage title and description come from the locale (seo.*), so they are written for search in each language.
{% enddoc %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_dark_background }}">

{%- liquid
  assign seo_title = page_title
  assign seo_description = page_description
  if request.page_type == 'index'
    assign seo_title = 'seo.home_title' | t
    assign seo_description = 'seo.home_description' | t
  endif
  assign og_title = seo_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: shop.name
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}

<title>
  {{ seo_title }}
  {%- if current_page != 1 %} – {{ 'general.page' | t: page: current_page }}{% endif -%}
  {%- assign seo_title_lower = seo_title | downcase -%}
  {%- unless seo_title_lower contains 'rawdot' %} | Rawdot{% endunless -%}
</title>
{%- if seo_description != blank %}
  <meta name="description" content="{{ seo_description | escape }}">
{%- endif %}
{%- liquid
  assign noindex = false
  if request.page_type == 'search' or request.page_type == 'cart' or request.page_type contains 'customers/'
    assign noindex = true
  endif
  # Thin listing pages: the store sells from the homepage.
  if request.page_type == 'list-collections' or request.page_type == 'collection'
    assign noindex = true
  endif
-%}
{%- if noindex %}
  <meta name="robots" content="noindex, follow">
{%- endif %}
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.google_site_verification != blank %}
  <meta
    name="google-site-verification"
    content="{{ settings.google_site_verification | remove: '"' | strip | escape }}"
  >
{%- endif %}
{%- if settings.bing_site_verification != blank %}
  <meta name="msvalidate.01" content="{{ settings.bing_site_verification | remove: '"' | strip | escape }}">
{%- endif %}

{%- if settings.favicon != blank %}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
{%- else %}
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  <link rel="icon" type="image/png" sizes="48x48" href="{{ 'favicon-48.png' | asset_url }}">
  <link rel="icon" type="image/png" sizes="96x96" href="{{ 'favicon-96.png' | asset_url }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
{%- endif %}

<meta property="og:site_name" content="rawdot">
{%- liquid
  case request.locale.iso_code
    when 'es'
      assign og_locale = 'es_MX'
    when 'en'
      assign og_locale = 'en_US'
    else
      assign og_locale = request.locale.iso_code | replace: '-', '_'
  endcase
-%}
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image and request.page_type != 'index' %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
{%- else %}
  <meta property="og:image" content="https:{{ 'og-image.jpg' | asset_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ 'seo.home_h1' | t | escape }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {% render 'product-structured-data', product: product %}
{%- endif %}
{% render 'site-structured-data' %}
