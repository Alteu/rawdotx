{% doc %}
  An image stored as a theme file (cutouts and photos set in the editor by file name). Files listed in
  `sized` below also exist as "<name>-480.webp" and "<name>-960.webp", so phones get a smaller file; they
  also get their real width and height. Add a new file to the list after creating its smaller copies.

  @param {string} file - Theme file name, e.g. "ice-version-1-cutout.webp"
  @param {string} alt - Alt text
  @param {string} [class] - Class of the img
  @param {string} [sizes] - The sizes attribute (default "90vw")
  @param {string} [loading] - "lazy" (default) or "eager"
  @param {string} [priority] - fetchpriority, "auto" (default) or "high"
{% enddoc %}
{%- liquid
  assign sized = 'arm-sleeve-1-cutout:964:1254,arm-sleeve-2-cutout:817:1254,arm-sleeve-detail-cuff-cutout:1100:1100,arm-sleeve-detail-logo-cutout:1100:1100,control-version-1-cutout:1170:976,control-version-2-cutout:1279:1021,glasspad-cutout:1280:974,ice-version-1-cutout:1175:977,ice-version-2-cutout:1285:1023,included-control-cutout:1286:773,included-ice-cutout:1272:810,arm-sleeve-lifestyle:1672:941,arm-sleeve-lifestyle-desk:1672:941,review-1:900:393,review-2:900:418,review-3:900:387,review-4:900:505,review-5:900:522,review-6:900:584,review-7:900:550,review-8:900:361,review-9:900:293' | split: ','
  assign small_widths = '480,960' | split: ','
  assign base = file | strip | remove_last: '.webp'
  assign width = 1200
  assign height = 1200
  assign srcset = ''
  for entry in sized
    assign parts = entry | split: ':'
    if parts[0] == base
      assign width = parts[1] | plus: 0
      assign height = parts[2] | plus: 0
      for size_text in small_widths
        assign size = size_text | plus: 0
        if size < width
          assign sized_file = base | append: '-' | append: size | append: '.webp' | asset_url
          assign srcset = srcset | append: sized_file | append: ' ' | append: size | append: 'w, '
        endif
      endfor
      assign full_file = file | strip | asset_url
      assign srcset = srcset | append: full_file | append: ' ' | append: width | append: 'w'
      break
    endif
  endfor
-%}
<img
  {% if class != blank %}
    class="{{ class }}"
  {% endif %}
  src="{{ file | strip | asset_url }}"
  {% if srcset != blank %}
    srcset="{{ srcset }}" sizes="{{ sizes | default: '90vw' }}"
  {% endif %}
  alt="{{ alt | escape }}"
  width="{{ width }}"
  height="{{ height }}"
  loading="{{ loading | default: 'lazy' }}"
  fetchpriority="{{ priority | default: 'auto' }}"
>
