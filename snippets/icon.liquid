{% doc %}
  Small inline UI icons. Decorative: always pair with visible or visually hidden text.

  @param {string} name - Icon name: account, menu, close, arrow-left, arrow-right
{% enddoc %}
<svg
  class="icon icon--{{ name }}"
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.6 3.3-5.5 7-5.5s6.2 1.9 7 5.5"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'arrow-left' -%}
      <path d="M15 5l-7 7 7 7"/>
    {%- when 'arrow-right' -%}
      <path d="M9 5l7 7-7 7"/>
  {%- endcase -%}
</svg>
