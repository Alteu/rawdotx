{% doc %}
  Logo intro: the "r" of the rawdot mark draws itself, the dot glides into place, then the screen lifts away.
  Plays once per browser tab session and can be turned off in theme settings. Visitors who prefer reduced
  motion get a short fade of the finished logo instead (see base.css).
{% enddoc %}
<div class="intro" aria-hidden="true">
  <svg class="intro__mark" viewBox="-30 -30 551 546" fill="none">
    <path
      class="intro__stroke"
      d="M56.5 486V194A137.5 137.5 0 0 1 194 56.5H469"
      stroke="currentColor"
      stroke-width="113"
      pathLength="1"
    />
    <path
      class="intro__fill"
      fill="currentColor"
      d="M0 194A194 194 0 0 1 194 0H429A40 40 0 0 1 469 40V73A40 40 0 0 1 429 113H194A81 81 0 0 0 113 194V446A40 40 0 0 1 73 486H40A40 40 0 0 1 0 446Z"
    />
    <circle class="intro__dot" cx="410" cy="405.5" r="80.5" fill="currentColor" />
  </svg>
</div>
