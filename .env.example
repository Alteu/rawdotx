# Copy to .env (git-ignored) and fill in. Never commit real values.

# Store the CLI works against, e.g. rawdot-dev.myshopify.com.
# Use a development store; the live store only with explicit approval.
SHOPIFY_FLAG_STORE=

# Theme Access app password (shptka_...). Lets the CLI run without a browser login.
SHOPIFY_CLI_THEME_TOKEN=

# Base URL Playwright tests run against. Defaults to `shopify theme dev` output.
BASE_URL=http://127.0.0.1:9292
