# Copy to .env (git-ignored) and fill in. Never commit real values.

# rawdot store (live site: rawdot.shop). Work only in unpublished themes; see CLAUDE.md.
SHOPIFY_FLAG_STORE=wide-clownfish-3r7al4-r4j2fm0h.myshopify.com

# Theme Access app password (shptka_...). Lets the CLI run without a browser login.
# Cloud sessions use a placeholder; the real value is a network secret on the environment.
SHOPIFY_CLI_THEME_TOKEN=

# Base URL Playwright tests run against. Defaults to `shopify theme dev` output.
BASE_URL=http://127.0.0.1:9292
