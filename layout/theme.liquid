<!doctype html>
{%- liquid
  assign rtl_languages = 'ar,he,fa,ur'
  assign language_code = request.locale.iso_code | split: '-' | first
  assign text_direction = 'ltr'
  if rtl_languages contains language_code
    assign text_direction = 'rtl'
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
  <head>
    {% render 'meta-tags' %}
    <script>
      document.documentElement.classList.add('js');
    </script>
    {%- comment -%}
      First visit only: open the store in the visitor's device language when the store offers it.
      Runs before anything paints so there is no flash. Skipped when the visitor chose a language before,
      arrived on a language-specific link (/es/…), or is a crawler. Changing the language by hand sticks.
    {%- endcomment -%}
    {%- if request.locale.primary and localization.available_languages.size > 1 and request.design_mode == false -%}
      <script>
        (function () {
          var languages = [
            {%- for language in localization.available_languages -%}
              { code: {{ language.iso_code | downcase | json }}, url: {{ language.root_url | json }} }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ];
          var current = {{ request.locale.iso_code | downcase | json }};
          try {
            if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return;
            if (localStorage.getItem('rawdot-language')) return;
            localStorage.setItem('rawdot-language', 'auto');
          } catch (e) {
            return;
          }
          var wanted = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          for (var i = 0; i < wanted.length; i++) {
            var pref = String(wanted[i]).toLowerCase();
            var match = null;
            for (var j = 0; j < languages.length; j++) {
              if (languages[j].code === pref) match = languages[j];
            }
            if (!match) {
              for (var k = 0; k < languages.length; k++) {
                if (languages[k].code.split('-')[0] === pref.split('-')[0]) match = languages[k];
              }
            }
            if (match) {
              if (match.code !== current) {
                window.location.replace(match.url.replace(/\/$/, '') + window.location.pathname + window.location.search + window.location.hash);
              }
              return;
            }
          }
        })();
      </script>
    {%- endif -%}
    {%- if settings.show_intro -%}
      <script>
        try {
          // Visitors from an ad or campaign link (utm_*, fbclid, gclid, ttclid…) go straight to the product.
          var fromAd = /[?&](utm_[a-z]+|fbclid|gclid|gbraid|wbraid|ttclid|msclkid)=/i.test(location.search);
          if (fromAd || sessionStorage.getItem('rawdot-intro')) {
            document.documentElement.classList.add('no-intro');
          } else {
            sessionStorage.setItem('rawdot-intro', '1');
          }
        } catch (e) {
          document.documentElement.classList.add('no-intro');
        }
      </script>
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    {%- if settings.show_intro -%}
      {% render 'intro' %}
    {%- endif -%}
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    {%- if request.page_type == 'policy' -%}
      {% render 'backdrop', variant: 'paper' %}
    {%- elsif request.page_type != 'index' -%}
      {% render 'backdrop' %}
    {%- endif -%}

    <main id="MainContent" tabindex="-1">
      {%- if request.page_type == 'policy' -%}
        <div class="policy-layout page-width">
          {% render 'policy-index', part: 'title' %}
          <div class="policy-layout__body">{{ content_for_layout }}</div>
          {% render 'policy-index', part: 'index' %}
        </div>
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}
    {% render 'about-dialog' %}

    <p class="visually-hidden" role="status" aria-live="polite" data-live-region></p>
    <div class="toasts" role="status" aria-live="polite" data-toasts></div>
    <script type="application/json" id="ThemeStrings">
      {
        "addToCart": {{ 'products.add_to_cart' | t | json }},
        "adding": {{ 'products.adding' | t | json }},
        "added": {{ 'products.added' | t | json }},
        "addError": {{ 'products.add_error' | t | json }},
        "cartCountOne": {{ 'header.cart_count' | t: count: 1 | replace: '1', '[count]' | json }},
        "cartCountOther": {{ 'header.cart_count' | t: count: 7 | replace: '7', '[count]' | json }},
        "soldOut": {{ 'products.sold_out' | t | json }},
        "unavailable": {{ 'products.unavailable' | t | json }},
        "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
        "cartChangeUrl": {{ routes.cart_change_url | append: '.js' | json }},
        "cartUpdated": {{ 'cart.updated' | t | json }},
        "cartUpdateError": {{ 'cart.update_error' | t | json }},
        "cartUrl": {{ routes.cart_url | json }},
        "toastAdded": {{ 'toast.added' | t | json }},
        "toastRemoved": {{ 'toast.removed' | t | json }},
        "toastViewCart": {{ 'toast.view_cart' | t | json }},
        "toastUpdated": {{ 'toast.updated' | t | json }},
        "toastQuantity": {{ 'toast.quantity' | t | json }},
        "toastUndo": {{ 'toast.undo' | t | json }},
        "toastDismiss": {{ 'toast.dismiss' | t | json }}
      }
    </script>
  </body>
</html>
