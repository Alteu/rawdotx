<div class="main-collection page-width">
  <h1 class="page-title">{{ collection.title | escape }}</h1>
  {%- if collection.description != blank -%}
    <div class="rte">{{ collection.description }}</div>
  {%- endif -%}

  {%- paginate collection.products by 24 -%}
    <ul class="product-grid" role="list">
      {%- for product in collection.products -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- else -%}
        <li class="product-grid__empty">{{ 'collections.empty' | t }}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      {{ paginate | default_pagination }}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": []
}
{% endschema %}
