{%- liquid
  assign cards = 'gpro,finalmouse,viper' | split: ','
-%}
<div class="story-section page-width" id="placement">
  <div class="story-section__header">
    <p class="section-label">{{ 'home.placement.label' | t }}</p>
    <h2 class="story-section__heading">{{ 'home.placement.heading' | t }}</h2>
    <p class="story-section__intro">{{ 'home.placement.description' | t }}</p>
  </div>
  <ul class="placement-grid" role="list">
    {%- for card in cards -%}
      {%- liquid
        assign alt_key = 'home.placement.' | append: card | append: '_alt'
        assign base = 'placement-' | append: card
        assign src_480 = base | append: '-480.webp' | asset_url
        assign src_960 = base | append: '-960.webp' | asset_url
        assign src_1536 = base | append: '-1536.webp' | asset_url
      -%}
      <li class="placement-card">
        <img
          src="{{ src_960 }}"
          srcset="{{ src_480 }} 480w, {{ src_960 }} 960w, {{ src_1536 }} 1536w"
          sizes="(min-width: 990px) 31vw, 92vw"
          width="1536"
          height="1024"
          loading="lazy"
          alt="{{ alt_key | t | escape }}"
        >
        <p>{{ alt_key | t }}</p>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Placement guide",
  "class": "section-story",
  "settings": [],
  "presets": [{ "name": "Placement guide" }]
}
{% endschema %}
