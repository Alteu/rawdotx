{%- liquid
  assign category_ids = 'skates,glasspads,arm-sleeves' | split: ','
  assign present_categories = ''
  for category_id in category_ids
    for block in section.blocks
      if block.settings.category == category_id
        assign present_categories = present_categories | append: category_id | append: ','
        break
      endif
    endfor
  endfor
  assign present_categories = present_categories | split: ','
  assign active_category = present_categories | first
  assign first_block_seen = false
-%}

<product-showcase class="showcase" data-default-category="{{ active_category }}">
  <h1 class="visually-hidden">{{ section.settings.heading | default: shop.name | escape }}</h1>

  {%- for category_id in present_categories -%}
    {%- liquid
      assign category_total = 0
      for block in section.blocks
        if block.settings.category == category_id
          assign category_total = category_total | plus: 1
        endif
      endfor
      assign category_index = 0
      assign panel_key = 'categories.' | append: category_id | replace: '-', '_'
    -%}
    <section
      class="showcase__panel"
      id="{{ category_id }}"
      aria-label="{{ panel_key | t }}"
      data-panel="{{ category_id }}"
      {% unless category_id == active_category %}
        hidden
      {% endunless %}
    >
      <div class="showcase__slides">
        {%- for block in section.blocks -%}
          {%- if block.settings.category != category_id -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign category_index = category_index | plus: 1
            capture specs
              for i in (1..4)
                assign value_key = 'spec_' | append: i | append: '_value'
                assign label_key = 'spec_' | append: i | append: '_label'
                if block.settings[value_key] != blank
                  echo block.settings[value_key] | append: '|' | append: block.settings[label_key] | append: '~~'
                endif
              endfor
            endcapture
            assign specs = specs | strip | remove_last: '~~'
            assign eager = false
            unless first_block_seen
              assign eager = true
              assign first_block_seen = true
            endunless
            assign scene_links = ''
            assign category_key = 'categories.' | append: category_id | replace: '-', '_'
            assign category_label = category_key | t
            assign eyebrow = 'rawdot / ' | append: category_label
          -%}
          {%- if category_total > 1 -%}
            {%- capture scene_links -%}
              {%- for option in section.blocks -%}
                {%- if option.settings.category != category_id or option.id == block.id -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign option_name = option.settings.title | default: option.settings.product.title
                  assign option_image = option.settings.image | default: option.settings.product.featured_media.preview_image
                -%}
                <button type="button" class="scene-chip" data-show-slide="{{ option.id }}">
                  <span class="scene-chip__thumb">
                    {%- if option_image != blank -%}
                      {{ option_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                    {%- else -%}
                      {% render 'logo-mark' %}
                    {%- endif -%}
                  </span>
                  <span class="scene-chip__text">
                    <span class="scene-chip__name">{{ option_name | escape }}</span>
                    <span class="scene-chip__type">{{ option.settings.badge | escape }}</span>
                  </span>
                  {% render 'icon', name: 'arrow-right' %}
                </button>
              {%- endfor -%}
            {%- endcapture -%}
          {%- endif -%}
          <div
            class="showcase__slide{% if category_index == 1 %} is-active{% endif %}"
            data-slide="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {% render 'buy-box',
              id: block.id,
              product: block.settings.product,
              title: block.settings.title,
              badge: block.settings.badge,
              tagline: block.settings.tagline,
              image: block.settings.image,
              specs: specs,
              details: block.settings.details,
              coming_soon: block.settings.coming_soon,
              eager: eager,
              eyebrow: eyebrow,
              scene_links: scene_links
            %}
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endfor -%}
</product-showcase>

{% schema %}
{
  "name": "Product showcase",
  "class": "section-showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading (for search engines and screen readers)",
      "info": "Not shown visually. Leave empty to use the store name."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "skates", "label": "Skates" },
            { "value": "glasspads", "label": "Glasspads" },
            { "value": "arm-sleeves", "label": "Arm sleeves" }
          ],
          "default": "skates"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Leave empty for a product that isn't in Shopify yet. It shows as coming soon."
        },
        {
          "type": "checkbox",
          "id": "coming_soon",
          "label": "Show as coming soon",
          "info": "Hides add-to-cart and shows a notify-me form.",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "info": "Leave empty to use the product title."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Type label",
          "info": "For example: Speed, Control. Also shown large and faint behind the product."
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "One-line description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the product's media. Transparent PNG/WebP works best. 3D models from the product's media are used when no image is set."
        },
        {
          "type": "header",
          "content": "Key specs"
        },
        { "type": "text", "id": "spec_1_value", "label": "Spec 1 value" },
        { "type": "text", "id": "spec_1_label", "label": "Spec 1 label" },
        { "type": "text", "id": "spec_2_value", "label": "Spec 2 value" },
        { "type": "text", "id": "spec_2_label", "label": "Spec 2 label" },
        { "type": "text", "id": "spec_3_value", "label": "Spec 3 value" },
        { "type": "text", "id": "spec_3_label", "label": "Spec 3 label" },
        { "type": "text", "id": "spec_4_value", "label": "Spec 4 value" },
        { "type": "text", "id": "spec_4_label", "label": "Spec 4 label" },
        {
          "type": "richtext",
          "id": "details",
          "label": "Extra details",
          "info": "Shown under \"See more\", after the product description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
