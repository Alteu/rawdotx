{%- liquid
  assign category_ids = 'skates,glasspads,arm-sleeves' | split: ','
  assign present_categories = ''
  for category_id in category_ids
    for block in section.blocks
      if block.settings.category == category_id
        assign present_categories = present_categories | append: category_id | append: ','
        break
      endif
    endfor
  endfor
  assign present_categories = present_categories | split: ','
  assign active_category = present_categories | first
  assign first_block_seen = false
-%}

<product-showcase class="showcase" data-default-category="{{ active_category }}">
  <h1 class="visually-hidden">{{ section.settings.heading | default: shop.name | escape }}</h1>

  {%- for category_id in present_categories -%}
    {%- liquid
      assign category_total = 0
      for block in section.blocks
        if block.settings.category == category_id
          assign category_total = category_total | plus: 1
        endif
      endfor
      assign category_index = 0
      assign panel_key = 'categories.' | append: category_id | replace: '-', '_'
    -%}
    <section
      class="showcase__panel"
      id="{{ category_id }}"
      aria-label="{{ panel_key | t }}"
      data-panel="{{ category_id }}"
      {% unless category_id == active_category %}
        hidden
      {% endunless %}
    >
      <div class="showcase__slides">
        {%- for block in section.blocks -%}
          {%- if block.settings.category != category_id -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign category_index = category_index | plus: 1
            capture specs
              for i in (1..4)
                assign value_key = 'spec_' | append: i | append: '_value'
                assign label_key = 'spec_' | append: i | append: '_label'
                if block.settings[value_key] != blank
                  echo block.settings[value_key] | append: '|' | append: block.settings[label_key] | append: '~~'
                endif
              endfor
            endcapture
            assign specs = specs | strip | remove_last: '~~'
            assign eager = false
            unless first_block_seen
              assign eager = true
              assign first_block_seen = true
            endunless
            assign versions = ''
            capture extra_specs
              for i in (1..4)
                assign value_key = 'detail_' | append: i | append: '_value'
                assign label_key = 'detail_' | append: i | append: '_label'
                if block.settings[value_key] != blank
                  echo block.settings[value_key] | append: '|' | append: block.settings[label_key] | append: '~~'
                endif
              endfor
            endcapture
            assign extra_specs = extra_specs | strip | remove_last: '~~'
            assign category_key = 'categories.' | append: category_id | replace: '-', '_'
            assign category_label = category_key | t
            assign eyebrow = 'rawdot / ' | append: category_label
          -%}
          {%- if category_total > 1 -%}
            {%- capture versions -%}
              <div class="versions" role="group" aria-label="{{ 'showcase.versions' | t }}">
                {%- for option in section.blocks -%}
                  {%- if option.settings.category != category_id -%}{%- continue -%}{%- endif -%}
                  {%- assign option_name = option.settings.title | default: option.settings.product.title -%}
                  <button
                    type="button"
                    class="versions__item"
                    data-show-slide="{{ option.id }}"
                    aria-pressed="{% if option.id == block.id %}true{% else %}false{% endif %}"
                  >
                    {%- if option.settings.badge != blank -%}
                      <span class="versions__name">{{ option.settings.badge | escape }}</span>
                      <span class="visually-hidden">{{ option_name | escape }}</span>
                    {%- else -%}
                      <span class="versions__name">{{ option_name | escape }}</span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- endcapture -%}
          {%- endif -%}
          <div
            class="showcase__slide{% if category_index == 1 %} is-active{% endif %}"
            data-slide="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {% render 'buy-box',
              id: block.id,
              product: block.settings.product,
              title: block.settings.title,
              badge: block.settings.badge,
              tagline: block.settings.tagline,
              image: block.settings.image,
              image_asset: block.settings.image_asset,
              specs: specs,
              details: block.settings.details,
              coming_soon: block.settings.coming_soon,
              eager: eager,
              eyebrow: eyebrow,
              versions: versions,
              extra_specs: extra_specs,
              guide_id: block.id,
              guide_type: block.settings.guide
            %}
          </div>
        {%- endfor -%}
      </div>

      {%- assign category_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.category != category_id -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign category_index = category_index | plus: 1 -%}
        {%- liquid
          capture guide_specs
            for i in (1..4)
              assign value_key = 'spec_' | append: i | append: '_value'
              assign label_key = 'spec_' | append: i | append: '_label'
              if block.settings[value_key] != blank
                echo block.settings[value_key] | append: '|' | append: block.settings[label_key] | append: '~~'
              endif
            endfor
          endcapture
          assign guide_specs = guide_specs | strip | remove_last: '~~'
          assign guide_name = block.settings.title | default: block.settings.product.title
        -%}
        {%- if block.settings.guide != 'none' and block.settings.guide != blank -%}
          <div
            class="showcase__guide"
            id="guide-{{ block.id }}"
            data-guide-for="{{ block.id }}"
            {% if category_index != 1 %}
              hidden
            {% endif %}
          >
            {%- if block.settings.guide == 'skates' -%}
              {% render 'guide-skates', id: block.id, name: guide_name, anchor: forloop.first %}
            {%- else -%}
              {% render 'guide-coming-soon',
                id: block.id,
                name: guide_name,
                tagline: block.settings.tagline,
                specs: guide_specs,
                lifestyle: block.settings.lifestyle_asset
              %}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </section>
  {%- endfor -%}
</product-showcase>

{% schema %}
{
  "name": "Product showcase",
  "class": "section-showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading (for search engines and screen readers)",
      "info": "Not shown visually. Leave empty to use the store name."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "skates", "label": "Skates" },
            { "value": "glasspads", "label": "Glasspads" },
            { "value": "arm-sleeves", "label": "Arm sleeves" }
          ],
          "default": "skates"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Leave empty for a product that isn't in Shopify yet. It shows as coming soon."
        },
        {
          "type": "checkbox",
          "id": "coming_soon",
          "label": "Show as coming soon",
          "info": "Hides add-to-cart and shows a notify-me form.",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "info": "Leave empty to use the product title."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Type label",
          "info": "For example: Speed, Control. Also shown large and faint behind the product."
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "One-line description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown first, before the product's own images. Transparent PNG/WebP works best. A 3D model in the product's media replaces the photos."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme image files",
          "info": "Replaces the product's own photos when set. Several files: separate with commas. Add -cutout to the file name for transparent images."
        },
        {
          "type": "text",
          "id": "lifestyle_asset",
          "label": "In-use photo (coming soon guide)",
          "info": "Theme file name without size and extension, e.g. arm-sleeve-lifestyle (needs -960.webp and -1672.webp files). Shown wide in the coming-soon guide."
        },
        {
          "type": "header",
          "content": "Key specs"
        },
        { "type": "text", "id": "spec_1_value", "label": "Spec 1 value" },
        { "type": "text", "id": "spec_1_label", "label": "Spec 1 label" },
        { "type": "text", "id": "spec_2_value", "label": "Spec 2 value" },
        { "type": "text", "id": "spec_2_label", "label": "Spec 2 label" },
        { "type": "text", "id": "spec_3_value", "label": "Spec 3 value" },
        { "type": "text", "id": "spec_3_label", "label": "Spec 3 label" },
        { "type": "text", "id": "spec_4_value", "label": "Spec 4 value" },
        { "type": "text", "id": "spec_4_label", "label": "Spec 4 label" },
        {
          "type": "header",
          "content": "More details (shown under \"See more\")"
        },
        { "type": "text", "id": "detail_1_value", "label": "Detail 1 value" },
        { "type": "text", "id": "detail_1_label", "label": "Detail 1 label" },
        { "type": "text", "id": "detail_2_value", "label": "Detail 2 value" },
        { "type": "text", "id": "detail_2_label", "label": "Detail 2 label" },
        { "type": "text", "id": "detail_3_value", "label": "Detail 3 value" },
        { "type": "text", "id": "detail_3_label", "label": "Detail 3 label" },
        { "type": "text", "id": "detail_4_value", "label": "Detail 4 value" },
        { "type": "text", "id": "detail_4_label", "label": "Detail 4 label" },
        {
          "type": "select",
          "id": "guide",
          "label": "Guide below the product",
          "info": "Shown under the product while it is selected.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "skates", "label": "Skates guide (placement, install, FAQ)" },
            { "value": "coming_soon", "label": "Coming soon (facts and notify me)" }
          ],
          "default": "none"
        },
        {
          "type": "richtext",
          "id": "details",
          "label": "Extra details",
          "info": "Shown under \"See more\", after the product description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
