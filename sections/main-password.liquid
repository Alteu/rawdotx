<div class="main-page page-width">
  {% render 'logo-mark', class: 'main-password__logo' %}
  <h1 class="page-title">{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'storefront_password', class: 'main-password__form' -%}
    <label for="Password">{{ 'password.label' | t }}</label>
    <input id="Password" type="password" name="password" autocomplete="current-password" required>
    {%- if form.errors -%}
      <p class="notify__error">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <button type="submit" class="button button--primary">{{ 'password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
