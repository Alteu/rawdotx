<div class="story-section page-width" id="origin">
  <p class="section-label">{{ 'home.origin.label' | t }}</p>
  <blockquote class="origin-quote">
    <p>{{ 'home.origin.quote' | t }}</p>
  </blockquote>
  <p class="story-section__intro">{{ 'home.origin.description' | t }}</p>
  <ul class="principles" role="list">
    {%- for i in (1..4) -%}
      {%- liquid
        assign title_key = 'home.origin.principle_' | append: i | append: '_title'
        assign text_key = 'home.origin.principle_' | append: i | append: '_description'
      -%}
      <li>
        <h3>{{ title_key | t }}</h3>
        <p>{{ text_key | t }}</p>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Origin story",
  "class": "section-story",
  "settings": [],
  "presets": [{ "name": "Origin story" }]
}
{% endschema %}
