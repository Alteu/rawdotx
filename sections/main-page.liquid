<div class="main-page page-width{% if request.page_type == '404' %} main-page--empty{% endif %}">
  {%- if request.page_type == '404' -%}
    <h1 class="page-title">{{ 'general.not_found_title' | t }}</h1>
    <p>{{ 'general.not_found_text' | t }}</p>
    <a class="button button--primary" href="{{ routes.root_url }}">{{ 'cart.continue_shopping' | t }}</a>
  {%- else -%}
    <h1 class="page-title">{{ page.title | escape }}</h1>
    {%- if page.content != blank -%}
      <div class="rte">{{ page.content }}</div>
    {%- endif -%}
    {%- if page.handle == 'contact' or page.template_suffix == 'contact' -%}
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact-form__success" role="status">{{ 'contact.success' | t }}</p>
        {%- else -%}
          <p class="contact-form__intro">{{ 'contact.intro' | t }}</p>
          {%- if form.errors -%}
            <p class="contact-form__error" id="ContactForm-error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="contact-form__field">
            <label for="ContactForm-name">{{ 'contact.name' | t }}</label>
            <input
              id="ContactForm-name"
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{{ form.name | escape }}"
            >
          </div>
          <div class="contact-form__field">
            <label for="ContactForm-email">{{ 'contact.email' | t }}</label>
            <input
              id="ContactForm-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              required
              value="{{ form.email | escape }}"
              {% if form.errors contains 'email' %}
                aria-invalid="true" aria-describedby="ContactForm-error"
              {% endif %}
            >
          </div>
          <div class="contact-form__field">
            <label for="ContactForm-message">{{ 'contact.message' | t }}</label>
            <textarea
              id="ContactForm-message"
              name="contact[body]"
              rows="6"
              required
            >{{ form.body | escape }}</textarea>
          </div>
          <button type="submit" class="button button--primary">{{ 'contact.send' | t }}</button>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Page",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
